<?xml version="1.0" ?>
<sdf version="1.5">
  <world name="ur3_world">
    
    <scene>
      <ambient>0.8 0.8 0.8 1.0</ambient>
      <background>0.9 0.9 0.9 1.0</background>
      <shadows>true</shadows>
    </scene>
    
    <!-- Ánh sáng và Mặt đất mặc định -->
    <include>
      <uri>model://sun</uri>
    </include>
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- 1. BÀN LÀM VIỆC (Kích thước 1.1 x 0.7 x 0.5) -->
    <model name="work_table">
      <static>true</static>
      <pose>0.35 0.0 0.25 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>1.1 0.7 0.5</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>1.1 0.7 0.5</size></box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Wood</name>
            </script>
          </material>
        </visual>
      </link>
    </model>

    <!-- 2. CAMERA 3D GIẢ LẬP (Vật cản cần né) -->
    <!-- <model name="camera_obstacle">
      <static>true</static>
      <pose>0.66 -0.05 0.55 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box><size>0.09 0.025 0.025</size></box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box><size>0.09 0.025 0.025</size></box>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Black</name>
            </script>
          </material>
        </visual>
      </link>
    </model> -->

    <!-- 3. HỘP CHỨA (Drop Bin) - Kích thước 0.15 x 0.15 x 0.1 -->
    <model name="drop_bin">
      <static>true</static>
      <!-- Tâm điểm của hộp -->
      <pose>0.5 0.0 0.50025 0 0 0</pose>
      
      <!-- Đáy hộp -->
      <link name="bin_base">
        <pose>0 0 0.005 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.15 0.15 0.005</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.15 0.15 0.005</size></box></geometry><material><script><name>Gazebo/Green</name></script></material></visual>
      </link>

      <!-- Thành trước -->
      <link name="bin_front">
        <pose>0.0725 0 0.0425 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.005 0.15 0.08</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.005 0.15 0.08</size></box></geometry><material><script><name>Gazebo/Green</name></script></material></visual>
      </link>

      <!-- Thành sau -->
      <link name="bin_back">
        <pose>-0.0725 0 0.0425 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.005 0.15 0.08</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.005 0.15 0.08</size></box></geometry><material><script><name>Gazebo/Green</name></script></material></visual>
      </link>

      <!-- Thành trái -->
      <link name="bin_left">
        <pose>0 0.0725 0.0425 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.14 0.005 0.08</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.14 0.005 0.08</size></box></geometry><material><script><name>Gazebo/Green</name></script></material></visual>
      </link>

      <!-- Thành phải -->
      <link name="bin_right">
        <pose>0 -0.0725 0.0425 0 0 0</pose>
        <collision name="col"><geometry><box><size>0.14 0.005 0.08</size></box></geometry></collision>
        <visual name="vis"><geometry><box><size>0.14 0.005 0.08</size></box></geometry><material><script><name>Gazebo/Green</name></script></material></visual>
      </link>
    </model>

  </world>
</sdf>