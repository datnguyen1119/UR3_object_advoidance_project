<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>custom_ur_simulation</name>
  <version>0.0.0</version>
  <description>Gazebo simulation for the custom UR3 setup — worlds, top-level spawn launch, sim controllers and RViz config.</description>
  <maintainer email="dat.nt216082@sis.hust.edu.vn">dat-ubuntu2204</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Robot model (URDF/meshes) lives in custom_ur_description -->
  <exec_depend>custom_ur_description</exec_depend>
  <exec_depend>ur3_moveit_config</exec_depend>

  <!-- Gazebo + control bringup -->
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>joint_trajectory_controller</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>

  <!-- MoveIt launched together with the sim -->
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>rviz2</exec_depend>

  <!-- Third-party dependency for Gazebo model paths -->
  <exec_depend>robotiq_description</exec_depend>
  <exec_depend>ur_description</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/.."/>
  </export>
</package>
