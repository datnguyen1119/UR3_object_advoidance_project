<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>custom_ur_description</name>
  <version>0.0.0</version>
  <description>URDF / xacro, meshes and Gazebo models for the custom UR3 + Robotiq + camera setup.</description>
  <maintainer email="dat.nt216082@sis.hust.edu.vn">dat-ubuntu2204</maintainer>
  <license>TODO: License declaration</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <buildtool_depend>xacro</buildtool_depend>
  <exec_depend>xacro</exec_depend>

  <exec_depend>ur_description</exec_depend>
  <exec_depend>robotiq_description</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/.."/>
  </export>
</package>
